// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]

}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// ENUMS
// =====================================================================
enum DocumentType {
  invoice
  bill
  purchase_order
  sales_order
  quotation
  payment
  expense
  receipt
  credit_note
  debit_note
  other
}

enum CurrencyCode {
  INR
  USD
  EUR
  GBP
  AED
  OTHER
}

enum PartyKind {
  issuing_company
  counterparty
  additional
}

// ---------- USER (parent table) --------------------------------------
model User {
  id                    String     @id @default(uuid()) @db.Uuid
  
  userEmail             String?    @unique @map("user_email")
  userMobileNumber      String?    @unique @map("user_mobile_number")
  
  otpCode               String?    @map("otp_code")
  otpExpiresAt          DateTime?  @map("otp_expires_at")
  isEmailVerified       Boolean    @default(false) @map("is_email_verified")
  isMobileVerified      Boolean    @default(false) @map("is_mobile_verified")
  
  AccessToken      String?    @map("access_token")
  ExpiryTimestamp  DateTime?  @map("expiry_timestamp")
  mailRefreshToken     String?    @map("refresh_token")

  
  userName              String?  @map("user_name")
  organizationName      String?  @map("organization_name")
  
  lastLoginAt           DateTime? @map("last_login_at")

  isBlocked             Boolean   @default(false) @map("is_blocked")
  blockTimestamp        DateTime? @map("block_timestamp")
  isDelete              Boolean   @default(false) @map("is_delete")
  deleteTimeStamp       DateTime? @map("delete_timestamp")
  Labels           String[]  @map("labels")
  LabelsIds        String[]  @map("labels_ids")
  msSubscriptionId   String?   @map("ms_subscription_id")

  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  documents             Document[]
  refrestoken           RefreshToken[]
  
  @@map("users")
}

model Document {
  id                  String        @id @default(uuid()) @db.Uuid

  // FK -> User
  userId              String        @map("user_id") @db.Uuid
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId  String  @map("message_id")            // 👈 @unique HATAO
  docIndex   Int     @default(0) @map("doc_index")

  documentType        DocumentType? @map("document_type")
  documentNumber      String?       @map("document_number")

  // dates: raw (as printed) + parsed (for sorting/filtering)
  documentDateRaw     String?       @map("document_date_raw")
  documentDate        DateTime?     @map("document_date")     @db.Date
  dueDateRaw          String?       @map("due_date_raw")
  dueDate             DateTime?     @map("due_date")          @db.Date
  expiryDateRaw       String?       @map("expiry_date_raw")
  expiryDate          DateTime?     @map("expiry_date")       @db.Date

  currency            CurrencyCode?
  currencyRaw         String?       @map("currency_raw")      // real code when currency = OTHER
  exchangeRate        Decimal?      @map("exchange_rate")     @db.Decimal(18, 6)

  subject             String?
  paymentTerms        String?       @map("payment_terms")
  deliveryTerms       String?       @map("delivery_terms")

  // GST / statutory
  placeOfSupply       String?       @map("place_of_supply")
  reverseCharge       Boolean?      @map("reverse_charge")

  // e-invoice
  irn                 String?
  ackNo               String?       @map("ack_no")
  ackDateRaw          String?       @map("ack_date_raw")

  // beneficiary bank details (where the customer should pay)
  bankAccountName     String?       @map("bank_account_name")
  bankName            String?       @map("bank_name")
  bankAccountNumber   String?       @map("bank_account_number")
  bankIfsc            String?       @map("bank_ifsc")
  bankSwift           String?       @map("bank_swift")
  bankBranch          String?       @map("bank_branch")
  bankUpi             String?       @map("bank_upi")

  // totals (1:1, flattened)
  subtotal            Decimal?      @db.Decimal(18, 2)
  totalDiscount       Decimal?      @map("total_discount")    @db.Decimal(18, 2)
  taxTotal            Decimal?      @map("tax_total")         @db.Decimal(18, 2)
  shippingCharges     Decimal?      @map("shipping_charges")  @db.Decimal(18, 2)
  roundOff            Decimal?      @map("round_off")         @db.Decimal(18, 2)
  adjustment          Decimal?      @db.Decimal(18, 2)
  grandTotal          Decimal?      @map("grand_total")       @db.Decimal(18, 2)
  balanceDue          Decimal?      @map("balance_due")       @db.Decimal(18, 2)
  amountPaid          Decimal?      @map("amount_paid")       @db.Decimal(18, 2)
  amountInWords       String?       @map("amount_in_words")

  // payment_info (1:1, mostly null)
  paymentMode         String?       @map("payment_mode")
  paidThrough         String?       @map("paid_through")
  expenseAccount      String?       @map("expense_account")

  notes               String?
  termsAndConditions  String?       @map("terms_and_conditions")
  additionalData      Json?         @map("additional_data")

  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt      @map("updated_at") @db.Timestamptz(6)

  parties             DocumentParty[]
  items               DocumentItem[]
  taxes               DocumentTax[]
  linkedDocuments     LinkedDocument[]

  // scoped per-user so two users can share a document number
  @@unique([userId, messageId, docIndex])
  @@index([messageId])
  @@index([userId])
  @@index([documentType])
  @@index([documentDate])
  @@index([documentNumber])
  @@map("documents")
}

// ---------- DOCUMENT PARTIES -----------------------------------------
// issuing_company + counterparty + additional_parties, all in one table
model DocumentParty {
  id          String    @id @default(uuid()) @db.Uuid
  documentId  String    @map("document_id") @db.Uuid
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  partyKind   PartyKind @map("party_kind")
  role        String?
  name        String?
  address     String?
  city        String?
  state       String?
  country     String?
  pincode     String?
  taxId       String?   @map("tax_id")
  companyId   String?   @map("company_id")
  phone       String[]
  email       String[]

  @@index([documentId])
  @@index([name])
  @@map("document_parties")
}

// ---------- DOCUMENT ITEMS -------------------------------------------
model DocumentItem {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  lineNo         Int?     @map("line_no")
  slNo           Int?     @map("sl_no")
  description    String?
  hsnSac         String?  @map("hsn_sac")
  quantity       Decimal? @db.Decimal(18, 4)
  unit           String?
  rate           Decimal? @db.Decimal(18, 4)

  discountPercent Decimal? @map("discount_percent") @db.Decimal(6, 2)
  discountAmount  Decimal? @map("discount_amount")  @db.Decimal(18, 2)

  taxPercent     Decimal? @map("tax_percent") @db.Decimal(6, 2)
  taxAmount      Decimal? @map("tax_amount")  @db.Decimal(18, 2)

  // optional per-line GST split
  cgstRate       Decimal? @map("cgst_rate")   @db.Decimal(6, 2)
  cgstAmount     Decimal? @map("cgst_amount") @db.Decimal(18, 2)
  sgstRate       Decimal? @map("sgst_rate")   @db.Decimal(6, 2)
  sgstAmount     Decimal? @map("sgst_amount") @db.Decimal(18, 2)
  igstRate       Decimal? @map("igst_rate")   @db.Decimal(6, 2)
  igstAmount     Decimal? @map("igst_amount") @db.Decimal(18, 2)

  amount         Decimal? @db.Decimal(18, 2)

  @@index([documentId])
  @@map("document_items")
}

// ---------- DOCUMENT TAXES -------------------------------------------
model DocumentTax {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  taxType       String?  @map("tax_type")
  ratePercent   Decimal? @map("rate_percent")   @db.Decimal(6, 2)
  taxableAmount Decimal? @map("taxable_amount") @db.Decimal(18, 2)
  amount        Decimal? @db.Decimal(18, 2)
  currency      String?

  @@index([documentId])
  @@map("document_taxes")
}

// ---------- LINKED DOCUMENTS -----------------------------------------
model LinkedDocument {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type        String?
  number      String?
  dateRaw     String?  @map("date_raw")
  amount      Decimal? @db.Decimal(18, 2)

  @@index([documentId])
  @@index([number])
  @@map("linked_documents")
}


model ResearchData {
  id                  String    @id @default(uuid()) @db.Uuid

  messageId           String?   @map("message_id")     // kis mail se
  operation           String?                          // "verdict" | "extraction"
  model               String?                          // pricing ke liye MUST
  inputTokens         Int?      @map("input_tokens")
  outputTokens        Int?      @map("output_tokens")
  totalTokens         Int?      @map("total_tokens")
  researchDataChild   ResearchDataChild[]

  extractedAt         DateTime? @map("extracted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)


  @@map("research_data")
}

model ResearchDataChild {
  id                  String    @id @default(uuid()) @db.Uuid
  documentType        String?   @map("document_type")
  confidenceScore     Decimal?  @map("confidence_score")     @db.Decimal(5, 2)
  completenessPercent Decimal?  @map("completeness_percent") @db.Decimal(5, 2)
  researchId         String    @map("research_id") @db.Uuid
  researchData        ResearchData @relation(fields: [researchId], references: [id], onDelete: Cascade)
   @@map("research_data_child")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  used       Boolean   @default(false)
  revoked    Boolean   @default(false)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  ip         String?   @db.Inet
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}